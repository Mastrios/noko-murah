<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>System Error - <%= statusCode %></title>
  
  <!-- Telegram Web App SDK -->
  <script src="https://telegram.org/js/telegram-web-app.js"></script>

  <!-- Google Fonts: Orbitron & Inter untuk kesan Sci-Fi Cyberpunk -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Orbitron:wght@700;900&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-deep: #030712;
      --card-bg: rgba(13, 20, 36, 0.9);
      --neon-cyan: #00f0ff;
      --neon-red: #ff0055;
      --text-main: #f3f4f6;
      --text-muted: #9ca3af;
      --border-cyber: rgba(255, 0, 85, 0.4);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', sans-serif; }

    body {
      background-color: var(--bg-deep);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 16px;
      overflow-x: hidden;
    }

    /* Efek Grid Cyberpunk Bergerak di Background */
    body::before {
      content: "";
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background-image: linear-gradient(rgba(255, 0, 85, 0.02) 1px, transparent 1px),
                        linear-gradient(90deg, rgba(255, 0, 85, 0.02) 1px, transparent 1px);
      background-size: 30px 30px;
      z-index: -1;
    }

    /* Kartu Kotak Cyberpunk Utama */
    .error-card {
      background: var(--card-bg);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid var(--border-cyber);
      box-shadow: 0 0 30px rgba(255, 0, 85, 0.15), inset 0 0 15px rgba(255, 0, 85, 0.03);
      width: 100%;
      max-width: 420px;
      padding: 40px 25px;
      border-radius: 16px;
      text-align: center;
      position: relative;
    }

    /* Sudut Aksen Cyberpunk */
    .error-card::before {
      content: "";
      position: absolute;
      top: -1px; left: -1px;
      width: 14px; height: 14px;
      border-top: 2px solid var(--neon-red);
      border-left: 2px solid var(--neon-red);
    }
    .error-card::after {
      content: "";
      position: absolute;
      bottom: -1px; right: -1px;
      width: 14px; height: 14px;
      border-bottom: 2px solid var(--neon-red);
      border-right: 2px solid var(--neon-red);
    }

    /* Status Code Glitch Style */
    .error-code {
      font-family: 'Orbitron', sans-serif;
      font-size: 64px;
      font-weight: 900;
      color: var(--neon-red);
      letter-spacing: 3px;
      margin-bottom: 5px;
      text-shadow: 0 0 15px rgba(255, 0, 85, 0.6);
      line-height: 1;
    }

    .error-title {
      font-family: 'Orbitron', sans-serif;
      font-size: 14px;
      font-weight: 700;
      color: var(--text-main);
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 20px;
    }

    .error-message {
      font-size: 13.5px;
      color: var(--text-muted);
      line-height: 1.6;
      margin-bottom: 30px;
    }

    /* Tombol Aksi Cyberpunk */
    .btn-cyber {
      background: transparent;
      color: var(--neon-cyan);
      border: 2px solid var(--neon-cyan);
      width: 100%;
      padding: 12px 20px;
      border-radius: 8px;
      font-family: 'Orbitron', sans-serif;
      font-weight: 700;
      font-size: 12.5px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      box-shadow: 0 0 15px rgba(0, 240, 255, 0.2);
      transition: all 0.3s ease;
      text-transform: uppercase;
      letter-spacing: 1px;
      text-decoration: none;
    }

    .btn-cyber:hover {
      background: var(--neon-cyan);
      color: var(--bg-deep);
      box-shadow: 0 0 25px rgba(0, 240, 255, 0.6);
      transform: translateY(-2px);
    }

    /* Responsif HP Kecil */
    @media (max-width: 400px) {
      .error-card {
        padding: 30px 18px;
      }
      .error-code {
        font-size: 52px;
      }
    }
  </style>
</head>
<body>

  <div class="error-card">
    <!-- Status Code -->
    <div class="error-code"><%= typeof statusCode !== 'undefined' ? statusCode : '500' %></div>
    
    <div class="error-title">⚠️ System Exception</div>
    
    <!-- Pesan error -->
    <p class="error-message">
      <%= typeof message !== 'undefined' ? message : 'Terjadi gangguan pada sistem atau halaman yang kamu cari tidak ditemukan.' %>
    </p>

    <!-- Tombol Aksi Dinamis -->
    <a href="/" id="actionBtn" class="btn-cyber">
      <svg id="btnIcon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
      <span id="btnText">Kembali ke Beranda</span>
    </a>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      const actionBtn = document.getElementById('actionBtn');
      const btnText = document.getElementById('btnText');
      const btnIcon = document.getElementById('btnIcon');

      const tg = window.Telegram?.WebApp;
      
      // Deteksi aman: Selama objek Telegram WebApp ada dan memiliki platform atau inisialisasi user
      const isTelegramMiniApp = tg && (tg.platform || (tg.initDataUnsafe && tg.initDataUnsafe.user));

      if (isTelegramMiniApp) {
        tg.ready();
        
        // Ubah teks & fungsi tombol menjadi Close Mini App
        btnText.textContent = "Tutup";
        
        // Ganti ikon panah menjadi ikon silang (X)
        btnIcon.innerHTML = `<line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>`;
        
        // Hentikan link default, jalankan fungsi close Telegram
        actionBtn.removeAttribute('href');
        actionBtn.addEventListener('click', function(e) {
          e.preventDefault();
          tg.close();
        });
      }
    });
  </script>

</body>
</html>
