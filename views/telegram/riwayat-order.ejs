<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Nokos - Riwayat Order Mobile</title>
    <!-- Google Fonts & FontAwesome Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <link rel="stylesheet" href="/css/style-telegram.css">

</head>
<body data-theme="light">

    <!-- NAVBAR -->
    <%- include('partials/header') %>

    <!-- KONTEN UTAMA RIWAYAT ORDER -->
    <div class="container">
        
        <div class="card">
            <!-- Header Card -->
            <div class="card-header">
                <div class="card-title">
                    <i class="fa-solid fa-clock-rotate-left" style="color: var(--primary-blue);"></i> Riwayat Order
                </div>
                <span class="order-badge-total" id="totalBadge">200 Order</span>
            </div>

            <!-- Summary Stats -->
            <div class="stats-grid">
                <div class="stat-box">
                    <span>Total</span>
                    <strong id="statTotal">200</strong>
                </div>
                <div class="stat-box">
                    <span>Sukses</span>
                    <strong style="color: #16a34a;" id="statSuccess">0%</strong>
                </div>
                <div class="stat-box">
                    <span>Terpakai</span>
                    <strong style="color: var(--primary-blue);" id="statSpent">Rp 0</strong>
                </div>
            </div>

            <!-- SEARCH & FILTER TABS -->
            <div class="search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" id="searchInput" placeholder="Cari nomor, aplikasi..." onkeyup="onSearchOrFilter()">
            </div>

            <div class="filter-tabs">
                <button class="tab-btn active" onclick="setFilter('all', this)">Semua</button>
                <button class="tab-btn" onclick="setFilter('success', this)">Sukses</button>
                <button class="tab-btn" onclick="setFilter('pending', this)">Pending</button>
                <button class="tab-btn" onclick="setFilter('canceled', this)">Refund</button>
            </div>

            <!-- List Order Halaman Ini -->
            <div class="history-list" id="historyList"></div>

            <!-- Informasi Halaman di ATAS -->
            <div class="pagination-info-box" id="pageInfo">Menampilkan 1-10 dari 200</div>

            <!-- Tombol Pagination di BAWAHNYA -->
            <div class="pagination-container" id="paginationControls"></div>
        </div>

    </div>

    <!-- JAVASCRIPT -->
    <script>
        // --- 1. GENERATE 200 DATA DUMMY ---
        const servicesList = [
            { name: "WhatsApp", icon: "fa-brands fa-whatsapp", price: 4500 },
            { name: "Telegram", icon: "fa-brands fa-telegram", price: 4000 },
            { name: "Google", icon: "fa-brands fa-google", price: 3500 },
            { name: "TikTok", icon: "fa-brands fa-tiktok", price: 3000 },
            { name: "Shopee", icon: "fa-solid fa-bag-shopping", price: 3500 }
        ];

        const countriesList = [
            { flag: "🇮🇩", code: "+62" },
            { flag: "🇲🇾", code: "+60" },
            { flag: "🇵🇭", code: "+63" }
        ];

        const statuses = ["success", "success", "success", "canceled", "pending"];
        const orderHistoryData = [];

        for (let i = 1; i <= 200; i++) {
            const srv = servicesList[Math.floor(Math.random() * servicesList.length)];
            const ctr = countriesList[Math.floor(Math.random() * countriesList.length)];
            const st = statuses[Math.floor(Math.random() * statuses.length)];
            
            const rawPhone = `${ctr.code} 8${Math.floor(10 + Math.random() * 89)}-${Math.floor(1000 + Math.random() * 9000)}`;
            const rawOtp = st === "success" ? `${Math.floor(100000 + Math.random() * 900000)}` : null;

            const day = Math.max(1, 10 - Math.floor(i / 15));
            const dateStr = `${day < 10 ? '0' + day : day} Okt, ${Math.floor(10 + Math.random() * 12)}:${Math.floor(10 + Math.random() * 50)}`;

            orderHistoryData.push({
                id: `#TRX-${9000 + i}`,
                service: srv.name,
                icon: srv.icon,
                flag: ctr.flag,
                server: i % 2 === 0 ? "Server 1" : "Server 2",
                phone: rawPhone,
                price: srv.price,
                status: st,
                otpCode: rawOtp,
                date: dateStr
            });
        }

        // --- 2. LOGIKA SEARCH, FILTER & PAGINATION ---
        let filteredData = [...orderHistoryData];
        let currentPage = 1;
        const itemsPerPage = 10;
        let currentFilterStatus = 'all';

        function updateStats() {
            const total = orderHistoryData.length;
            const successItems = orderHistoryData.filter(d => d.status === "success");
            const successRate = Math.round((successItems.length / total) * 100);
            const totalSpent = successItems.reduce((sum, item) => sum + item.price, 0);

            document.getElementById('statTotal').textContent = total;
            document.getElementById('statSuccess').textContent = `${successRate}%`;
            document.getElementById('statSpent').textContent = 'Rp ' + totalSpent.toLocaleString('id-ID');
        }

        function setFilter(status, btn) {
            currentFilterStatus = status;
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            onSearchOrFilter();
        }

        function onSearchOrFilter() {
            const searchQuery = document.getElementById('searchInput').value.toLowerCase().trim();

            filteredData = orderHistoryData.filter(item => {
                const matchStatus = (currentFilterStatus === 'all') || (item.status === currentFilterStatus);
                const matchQuery = item.phone.toLowerCase().includes(searchQuery) ||
                                   item.service.toLowerCase().includes(searchQuery);
                return matchStatus && matchQuery;
            });

            currentPage = 1;
            renderHistoryPage(currentPage);
        }

        function renderHistoryPage(page) {
            const listContainer = document.getElementById('historyList');
            listContainer.innerHTML = '';

            const totalItems = filteredData.length;
            const totalPages = Math.ceil(totalItems / itemsPerPage) || 1;

            if (totalItems === 0) {
                listContainer.innerHTML = `
                    <div class="empty-state">
                        <i class="fa-solid fa-box-open"></i>
                        <p>Riwayat tidak ditemukan.</p>
                    </div>
                `;
                document.getElementById('pageInfo').textContent = `Menampilkan 0 dari 0`;
                renderPaginationControls(0, 1);
                return;
            }

            const startIndex = (page - 1) * itemsPerPage;
            const endIndex = Math.min(startIndex + itemsPerPage, totalItems);
            const pageData = filteredData.slice(startIndex, endIndex);

            pageData.forEach(item => {
                let statusBadge = '';
                let otpDisplay = '';

                if (item.status === 'success') {
                    statusBadge = `<span class="status-pill status-success"><i class="fa-solid fa-check"></i> Sukses</span>`;
                    otpDisplay = `<div class="otp-row">OTP: ${item.otpCode}</div>`;
                } else if (item.status === 'pending') {
                    statusBadge = `<span class="status-pill status-pending"><i class="fa-solid fa-clock"></i> Pending</span>`;
                    otpDisplay = `<div class="otp-row" style="color:var(--text-muted);"><i class="fa-solid fa-spinner fa-spin"></i> Menunggu SMS...</div>`;
                } else {
                    statusBadge = `<span class="status-pill status-canceled"><i class="fa-solid fa-rotate-left"></i> Refund</span>`;
                    otpDisplay = `<div class="otp-row" style="color:#dc2626;">Dibatalkan</div>`;
                }

                const html = `
                    <div class="history-card-item">
                        <div class="history-item-header">
                            <div class="service-info">
                                <div class="service-icon"><i class="${item.icon}"></i></div>
                                <div class="service-title-group">
                                    <span class="service-name">${item.service}</span>
                                    <span style="font-size:0.75rem;">${item.flag}</span>
                                </div>
                            </div>
                            ${statusBadge}
                        </div>

                        <div class="history-item-body">
                            <div class="phone-row">
                                <span class="phone-number">${item.phone}</span>
                            </div>
                            ${otpDisplay}
                        </div>

                        <div class="history-item-footer">
                            <div class="footer-left">
                                <span class="server-tag">${item.server}</span>
                                <span>• ${item.date}</span>
                            </div>
                            <span class="price-text">Rp ${item.price.toLocaleString('id-ID')}</span>
                        </div>
                    </div>
                `;
                listContainer.innerHTML += html;
            });

            document.getElementById('pageInfo').textContent = `Menampilkan ${startIndex + 1}-${endIndex} dari ${totalItems}`;
            document.getElementById('totalBadge').textContent = `${totalItems} Order`;
            renderPaginationControls(totalItems, totalPages);
        }

        function renderPaginationControls(totalItems, totalPages) {
            const controlsContainer = document.getElementById('paginationControls');
            controlsContainer.innerHTML = '';

            if (totalItems === 0) return;

            const prevBtn = document.createElement('button');
            prevBtn.className = `page-btn ${currentPage === 1 ? 'disabled' : ''}`;
            prevBtn.innerHTML = `<i class="fa-solid fa-chevron-left"></i>`;
            prevBtn.onclick = () => { if (currentPage > 1) goToPage(currentPage - 1); };
            controlsContainer.appendChild(prevBtn);

            let pagesToShow = [];

            if (totalPages <= 5) {
                for (let i = 1; i <= totalPages; i++) pagesToShow.push(i);
            } else {
                pagesToShow.push(1);

                let start = Math.max(2, currentPage - 1);
                let end = Math.min(totalPages - 1, currentPage + 1);

                if (currentPage <= 3) {
                    end = 4;
                } else if (currentPage >= totalPages - 2) {
                    start = totalPages - 3;
                }

                if (start > 2) {
                    pagesToShow.push('...');
                }

                for (let i = start; i <= end; i++) {
                    if (!pagesToShow.includes(i)) pagesToShow.push(i);
                }

                if (end < totalPages - 1) {
                    pagesToShow.push('...');
                }

                if (!pagesToShow.includes(totalPages)) {
                    pagesToShow.push(totalPages);
                }
            }

            pagesToShow.forEach(p => {
                const btn = document.createElement('button');
                if (p === '...') {
                    btn.className = 'page-btn disabled';
                    btn.style.border = 'none';
                    btn.style.background = 'transparent';
                    btn.textContent = '...';
                } else {
                    btn.className = `page-btn ${p === currentPage ? 'active' : ''}`;
                    btn.textContent = p;
                    btn.onclick = () => goToPage(p);
                }
                controlsContainer.appendChild(btn);
            });

            const nextBtn = document.createElement('button');
            nextBtn.className = `page-btn ${currentPage === totalPages ? 'disabled' : ''}`;
            nextBtn.innerHTML = `<i class="fa-solid fa-chevron-right"></i>`;
            nextBtn.onclick = () => { if (currentPage < totalPages) goToPage(currentPage + 1); };
            controlsContainer.appendChild(nextBtn);
        }

        function goToPage(page) {
            currentPage = page;
            renderHistoryPage(currentPage);
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // NAVBAR & THEME INTERACTION
        const profileBtn = document.getElementById('profileBtn');
        const dropdownMenu = document.getElementById('dropdownMenu');
        profileBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            dropdownMenu.classList.toggle('show');
        });
        window.addEventListener('click', () => { dropdownMenu.classList.remove('show'); });

        function toggleTheme() {
            const body = document.body;
            const themeIcon = document.getElementById('themeIcon');
            if (body.getAttribute('data-theme') === 'light') {
                body.setAttribute('data-theme', 'dark');
                themeIcon.className = 'fa-solid fa-sun';
            } else {
                body.setAttribute('data-theme', 'light');
                themeIcon.className = 'fa-solid fa-moon';
            }
        }

        // Inisialisasi
        updateStats();
        renderHistoryPage(1);
    </script>
</body>
</html>
